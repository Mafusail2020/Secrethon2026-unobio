        "program",
        "entities",
        "evidence_ids",
        "twin_stats"
      ],
      "writes": [
        "scratch"
      ],
      "parent": "efficacy_assessment",
      "correctable": true,
      "critical": false
    },
    {
      "id": "efficacy_extract",
      "label": "Efficacy extractor",
      "kind": "analysis",
      "phase": "assess",
      "description": "Fills the five-step translation chain and drafts efficacy claims from the gathered material, each citing evidence ids.",
