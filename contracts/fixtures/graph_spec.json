        "program",
        "entities",
        "scratch"
      ],
      "writes": [
        "scratch"
      ],
      "parent": "efficacy_assessment",
      "correctable": true,
      "critical": false
    },
    {
      "id": "efficacy_gate",
      "label": "Efficacy claim gate",
      "kind": "processing",
      "phase": "assess",
      "description": "Rejects or downgrades drafted claims whose evidence ids are not valid and settles the translation chain.",
