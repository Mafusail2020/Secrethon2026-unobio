        "claims",
        "twin_stats",
        "scratch"
      ],
      "writes": [
        "risk_adjustments",
        "assessments"
      ],
      "parent": "efficacy_assessment",
      "correctable": true,
      "critical": false
    },
    {
      "id": "safety_assessment",
