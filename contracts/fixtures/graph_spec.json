        "program",
        "entities",
        "questions",
        "evidence_ids",
        "twin_stats"
      ],
      "writes": [
        "claims",
        "risk_adjustments",
        "assessments",
        "scratch",
        "translation_chain"
      ],
      "parent": null,
      "correctable": true,
      "critical": false
    },
    {
      "id": "efficacy_gather",
      "label": "Efficacy gatherer",
      "kind": "knowledge",
      "phase": "assess",
      "description": "Collects what bears on efficacy from the frozen evidence and the precedent base: association evidence by data type, same-target trial outcomes, class history and your preclinical data. No model.",
