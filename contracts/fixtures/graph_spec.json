    {
      "id": "efficacy_assessment",
      "label": "Efficacy assessment",
      "kind": "efficacy",
      "phase": "assess",
      "description": "Checks whether the drug does what it is meant to do in people: gathers the biology and the precedent, extracts what the evidence says, then scores it with formulas.",
